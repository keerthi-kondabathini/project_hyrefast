# ============================================================
# HyreFast — Environment Template
# Copy this file to .env.staging / .env.test / .env.production
# and fill in real values. Never commit the filled-in files.
# ============================================================
BASE_URL=https://staging.hyrefast.ai
USER_EMAIL=your-user@yopmail.com
USER_PASSWORD=your-password
USER_FULL_NAME=Your Name
WORKSPACE_NAME=Your Workspace
WORKSPACE_SLUG=your-workspace
HEADLESS=true

# Optional: resume screening defaults
RESUME_FILE_PATH=fixtures/resumes/Advanced_DotNet_Resume_7.docx
RESUME_FILE_NAME=Advanced_DotNet_Resume_7.docx
CANDIDATE_NAME=Candidate Name
CANDIDATE_EMAIL=candidate@yopmail.com
EXPLORER_EMAIL=explorer@yopmail.com

# Sensitive values moved out of data/testData.json
NEW_MEMBER_PASSWORD=your-new-member-password
PROFILE_EMAIL=your-profile@yopmail.com
SIGNUP_PASSWORD=your-signup-password
COMPANY_LOGO_FILE=fixtures/your-logo.jpeg
PIPELINE_APPLICATIONS_URL=https://staging.hyrefast.ai/job/<JOB_ID>/applications/
